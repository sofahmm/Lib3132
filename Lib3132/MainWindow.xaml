<Window x:Class="Lib3132.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lib3132"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Text="Авторизация"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="DarkRed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="0"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="Логин:"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="DarkRed"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="0"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="Пароль:"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="DarkRed"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
        <TextBox Grid.Column="2"
                 Grid.ColumnSpan="2"
                 Grid.Row="1"
                 Height="50"
                 Width="300"
                 HorizontalAlignment="Left"
                 Margin="10 0 0 0"
                 Padding="5 0 0 0"
                 FontSize="22"
                 VerticalContentAlignment="Center"
                 Name="loginTb"/>
        <PasswordBox Grid.Column="2"
                     Grid.ColumnSpan="2"
                     Grid.Row="2"
                     Height="50"
                     Width="300"
                     HorizontalAlignment="Left"
                     Margin="10 0 0 0"
                     Padding="5 0 0 0"
                     FontSize="22"
                     VerticalContentAlignment="Center"
                     Name="passwordTb"/>
        <Button Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                Height="50"
                Width="200"
                Content="Войти"
                FontSize="20"
                FontWeight="Bold"
                Foreground="Crimson"
                Background="AliceBlue"
                Name="loginBtn"
                Click="loginBtn_Click"/>
    </Grid>
</Window>
